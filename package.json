{
  "name": "nestjs-business-engine",
  "version": "0.0.0-development",
  "description": "Business rules engine for NestJS: transform payloads with JSONata, match them with MongoDB-style conditions and produce results from rules stored as data.",
  "author": "Pedro Sodré",
  "license": "MIT",
  "homepage": "https://github.com/pedrosodre/nestjs-business-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrosodre/nestjs-business-engine.git"
  },
  "bugs": {
    "url": "https://github.com/pedrosodre/nestjs-business-engine/issues"
  },
  "keywords": [
    "nestjs",
    "nest",
    "rules",
    "rules-engine",
    "business-rules",
    "decision-engine",
    "jsonata",
    "mongodb-query",
    "sift",
    "pricing",
    "standard-schema"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.mjs",
    "index.d.mts",
    "llms.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run api:check && npm run lint:package && npm run test:compat",
    "prepare": "husky",
    "test:compat": "node tests/compat/runtime.cjs && node tests/compat/runtime.mjs",
    "lint:package": "publint --strict && attw --pack .",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "jsonata": "2.2.2",
    "sift": "17.1.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "9.39.5",
    "@microsoft/api-extractor": "7.60.1",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/testing": "11.2.8",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "semantic-release": "25.0.9",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "./lib/**/*.ts"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/tests"
    ],
    "testEnvironment": "node",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 80,
        "functions": 95,
        "lines": 95
      }
    }
  },
  "lint-staged": {
    "*.{ts,mts,cts,mjs,cjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
