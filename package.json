{
  "name": "nestjs-business-engine",
  "version": "0.0.0-development",
  "description": "Business rules engine for NestJS: transform payloads with JSONata, match them with MongoDB-style conditions and produce results from rules stored as data.",
  "author": "Pedro Sodré",
  "license": "MIT",
  "homepage": "https://github.com/pedrosodre/nestjs-business-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrosodre/nestjs-business-engine.git"
  },
  "bugs": {
    "url": "https://github.com/pedrosodre/nestjs-business-engine/issues"
  },
  "keywords": [
    "nestjs",
    "nest",
    "rules",
    "rules-engine",
    "business-rules",
    "decision-engine",
    "jsonata",
    "mongodb-query",
    "sift",
    "pricing",
    "standard-schema"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "jsonata": "2.2.2",
    "sift": "17.1.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/testing": "11.2.8",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "jest": "29.7.0",
    "prettier": "3.9.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "./lib/**/*.ts"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/tests"
    ],
    "testEnvironment": "node",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 80,
        "functions": 95,
        "lines": 95
      }
    }
  }
}
